{
  "$defs": {
    "ExtractionStatus": {
      "description": "Explicit extraction status for every domain field.\n\nNEVER use null alone to represent missing fields.",
      "enum": [
        "FOUND",
        "NOT_FOUND",
        "NOT_APPLICABLE",
        "AMBIGUOUS",
        "FAILED_VALIDATION"
      ],
      "title": "ExtractionStatus",
      "type": "string"
    },
    "MSMEFieldResult": {
      "description": "Extraction result for a single MSME valuation field.",
      "properties": {
        "field_name": {
          "title": "Field Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "required_by_msme": {
          "default": true,
          "title": "Required By Msme",
          "type": "boolean"
        },
        "current_period_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeriodValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparative_period_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeriodValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/ExtractionStatus",
          "default": "NOT_FOUND"
        },
        "is_derived": {
          "default": false,
          "title": "Is Derived",
          "type": "boolean"
        },
        "calculation_formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Formula"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_matches": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Candidate Matches",
          "type": "array"
        }
      },
      "required": [
        "field_name",
        "category"
      ],
      "title": "MSMEFieldResult",
      "type": "object"
    },
    "PeriodValue": {
      "description": "Extracted financial value for a single reporting period (e.g. FY25, FY24).",
      "properties": {
        "period_label": {
          "title": "Period Label",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "parsed_numeric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Numeric"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "status": {
          "$ref": "#/$defs/ExtractionStatus",
          "default": "NOT_FOUND"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "period_label",
        "raw_value"
      ],
      "title": "PeriodValue",
      "type": "object"
    },
    "Provenance": {
      "description": "Complete provenance and evidence record attached to every emitted domain value.",
      "properties": {
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "raw_value_as_printed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value As Printed"
        },
        "parsed_numeric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Numeric"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "note_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Reference"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "SourceReference": {
      "description": "Fine-grained atomic reference to source tokens, pages, tables, and cells.",
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "row_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "ValidationIssue": {
      "description": "Structured validation diagnostic issue.",
      "properties": {
        "issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "issue_type": {
          "title": "Issue Type",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "issue_type",
        "description"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "description": "Domain output model for MSME valuation (47 target fields).",
  "properties": {
    "schema_version": {
      "default": "v0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "company_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company Name"
    },
    "financial_year": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Financial Year"
    },
    "reporting_currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reporting Currency"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/MSMEFieldResult"
      },
      "title": "Fields",
      "type": "object"
    },
    "completion_rate": {
      "default": 0.0,
      "title": "Completion Rate",
      "type": "number"
    },
    "validation_issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Validation Issues",
      "type": "array"
    }
  },
  "required": [
    "document_id"
  ],
  "title": "MSMEValuationDocument",
  "type": "object"
}