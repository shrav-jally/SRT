      "type": "object"
    },
    "DocumentMetadata": {
      "description": "High-level document metadata inferred from canonical tokens and sections.",
      "properties": {
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
