    "ValidationIssue": {
      "description": "Structured validation diagnostic issue.",
      "properties": {
        "issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "issue_type": {
          "title": "Issue Type",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
