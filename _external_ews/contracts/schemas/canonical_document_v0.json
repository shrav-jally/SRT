  "description": "Canonical document contract v0.\n\nThe sole input format for all Product 2 domain extractors.",
  "properties": {
    "schema_version": {
      "default": "v0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "source_metadata": {
      "$ref": "#/$defs/SourceMetadata"
    },
    "document_metadata": {
      "$ref": "#/$defs/DocumentMetadata"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/CanonicalPage"
      },
      "title": "Pages",
      "type": "array"
    },
    "token_registry": {
      "additionalProperties": {
