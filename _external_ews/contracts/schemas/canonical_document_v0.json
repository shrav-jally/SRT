      "title": "CanonicalSection",
      "type": "object"
    },
    "CanonicalTable": {
      "description": "Structured table extracted from bounding box regions.",
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "page_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Page Numbers",
          "type": "array"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "source_block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Block Id"
        },
        "is_borderless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Borderless"
        },
        "detection_method": {
          "title": "Detection Method",
          "type": "string"
        },
        "structure_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structure Method"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CanonicalRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/CanonicalColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/CanonicalCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "NOT_RUN"
        },
        "validation_issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Validation Issues",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "table_id",
        "bbox",
        "detection_method"
      ],
      "title": "CanonicalTable",
      "type": "object"
    },
    "CanonicalToken": {
