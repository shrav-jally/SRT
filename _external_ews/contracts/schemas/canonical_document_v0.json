{
  "$defs": {
    "BoundingBox": {
      "description": "Normalized or absolute coordinate bounding box [x0, y0, x1, y1].",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CanonicalBlock": {
      "description": "Layout block grouping primitive tokens (heading, paragraph, table, list, etc.).",
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "block_type": {
          "enum": [
            "heading",
            "paragraph",
            "table",
            "figure",
            "list",
            "footnote",
            "other"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "reading_order_index": {
          "default": 0,
          "title": "Reading Order Index",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "block_id",
        "page_number",
        "block_type",
        "bbox"
      ],
      "title": "CanonicalBlock",
      "type": "object"
    },
    "CanonicalCell": {
      "description": "Grid cell within a CanonicalTable.",
      "properties": {
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "row_index": {
          "title": "Row Index",
          "type": "integer"
        },
        "column_index": {
          "title": "Column Index",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "raw_text": {
          "default": "",
          "title": "Raw Text",
          "type": "string"
        },
        "numeric_token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Numeric Token Ids",
          "type": "array"
        },
        "parsed_numeric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Numeric"
        },
        "rowspan": {
          "default": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "header",
            "data",
            "subtotal",
            "total",
            "note",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "row_index",
        "column_index",
        "bbox"
      ],
      "title": "CanonicalCell",
      "type": "object"
    },
    "CanonicalColumn": {
      "description": "Column structure within a CanonicalTable.",
      "properties": {
        "column_index": {
          "title": "Column Index",
          "type": "integer"
        },
        "column_id": {
          "title": "Column Id",
          "type": "string"
        },
        "header_text": {
          "default": "",
          "title": "Header Text",
          "type": "string"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "label",
            "numeric",
            "note",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "column_index",
        "column_id"
      ],
      "title": "CanonicalColumn",
      "type": "object"
    },
    "CanonicalIndexes": {
      "description": "Lookups and inverted indexes for Product 2 domain extractors.",
      "properties": {
        "sections_by_type": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Sections By Type",
          "type": "object"
        },
        "table_ids_by_section_id": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Table Ids By Section Id",
          "type": "object"
        },
        "blocks_by_page": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Blocks By Page",
          "type": "object"
        },
        "token_ids_by_page": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Token Ids By Page",
          "type": "object"
        },
        "tables_by_page": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Tables By Page",
          "type": "object"
        },
        "normalized_title_to_section_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Normalized Title To Section Ids",
          "type": "object"
        },
        "note_number_to_section_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Note Number To Section Ids",
          "type": "object"
        }
      },
      "title": "CanonicalIndexes",
      "type": "object"
    },
    "CanonicalPage": {
      "description": "Page-level container and token index.",
      "properties": {
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "table_ids": {
          "items": {
            "type": "string"
          },
          "title": "Table Ids",
          "type": "array"
        }
      },
      "required": [
        "page_number",
        "width",
        "height"
      ],
      "title": "CanonicalPage",
      "type": "object"
    },
    "CanonicalRow": {
      "description": "Row structure within a CanonicalTable.",
      "properties": {
        "row_index": {
          "title": "Row Index",
          "type": "integer"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "cell_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cell Ids",
          "type": "array"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "header",
            "data",
            "subtotal",
            "total",
            "note",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "row_index",
        "row_id"
      ],
      "title": "CanonicalRow",
      "type": "object"
    },
    "CanonicalSection": {
      "description": "Logical document section boundary.",
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "title_raw": {
          "title": "Title Raw",
          "type": "string"
        },
        "title_normalized": {
          "title": "Title Normalized",
          "type": "string"
        },
        "section_type": {
          "default": "other",
          "title": "Section Type",
          "type": "string"
        },
        "subcategory": {
          "default": "",
          "title": "Subcategory",
          "type": "string"
        },
        "parent_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Section Id"
        },
        "child_section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Child Section Ids",
          "type": "array"
        },
        "start_page": {
          "title": "Start Page",
          "type": "integer"
        },
        "end_page": {
          "title": "End Page",
          "type": "integer"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "table_ids": {
          "items": {
            "type": "string"
          },
          "title": "Table Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "taxonomy_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy Path"
        }
      },
      "required": [
        "section_id",
        "title_raw",
        "title_normalized",
        "start_page",
        "end_page"
